// PropForce AI — identity and tenancy schema (Phase 1, PR 2).
//
// Conventions
// - Every tenant-owned table has `tenant_id` and is protected by PostgreSQL row-level security
//   (see the RLS section of the migration). The application role cannot bypass it.
// - Platform tables (users, sessions, MFA factors, feature flags) have no tenant_id and are only
//   reachable through code paths that never expose them across users.
// - IDs are UUIDv7 generated by Prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Platform ─────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  fullName        String    @map("full_name")
  locale          String    @default("en")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  /// Set by a platform admin. A suspended user cannot sign in; their sessions are revoked.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedReason String?   @map("suspended_reason")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  mfaFactors  MfaFactor[]
  tokens      UserToken[]

  @@map("user")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Refresh tokens rotate; all tokens issued from one login share a family for reuse detection.
  familyId         String    @map("family_id") @db.Uuid
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("session")
}

enum UserTokenType {
  email_verification
  password_reset
}

/// Single-use tokens sent by email. Only a SHA-256 hash of the token is stored.
model UserToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_token")
}

enum MfaFactorType {
  totp
  recovery_code
}

model MfaFactor {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaFactorType
  /// TOTP secret, envelope-encrypted by the application. Recovery codes store a hash instead.
  secretEncrypted Bytes?        @map("secret_encrypted")
  codeHash        String?       @map("code_hash")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  usedAt          DateTime?     @map("used_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, so a code cannot be replayed within its window.
  lastUsedStep    BigInt?       @map("last_used_step")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("mfa_factor")
}

/// Actions taken by platform administrators. Not tenant-scoped; agency actions are also written
/// to that agency's audit log.
model PlatformAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("platform_audit_log")
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  /// Optional per-agency overrides: { "<agencyId>": true }
  overrides   Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum AgencyStatus {
  pending
  active
  suspended
  cancelled
}

enum ApprovalStatus {
  not_required
  pending
  approved
  rejected
}

/// The tenant. Its own id is the tenant id.
model Agency {
  id              String         @id @db.Uuid
  name            String
  slug            String         @unique
  emirate         String
  tradeLicenseNo  String?        @map("trade_license_no")
  /// RERA Office Registration Number or equivalent; optional, entered by the agency.
  orn             String?
  status          AgencyStatus   @default(pending)
  onboardedAt     DateTime?      @map("onboarded_at") @db.Timestamptz(3)
  /// Platform approval, used when the platform requires new agencies to be approved.
  approvalStatus  ApprovalStatus @default(not_required) @map("approval_status")
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  /// Why the platform suspended, rejected or reactivated the agency. Shown to the agency.
  statusReason    String?        @map("status_reason")
  /// Commercial plan name; billing is not wired yet.
  plan            String         @default("trial")
  /// Maximum active members plus pending invitations. Null = unlimited.
  seatLimit       Int?           @map("seat_limit")
  /// Maximum listings (not deleted). Null = unlimited.
  listingLimit    Int?           @map("listing_limit")
  /// The platform's own agency ("PropForce Direct") where platform admins list properties.
  isPlatformOwned Boolean        @default(false) @map("is_platform_owned")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings           AgencySettings?
  memberships        Membership[]
  teams              Team[]
  invitations        Invitation[]
  auditLogs          AuditLog[]
  projects           Project[]
  properties         Property[]
  permits            PropertyPermit[]
  contacts           Contact[]
  consents           ConsentRecord[]
  leads              Lead[]
  leadEvents         LeadActivity[]
  whatsappAccounts   WhatsAppAccount[]
  conversations      Conversation[]
  messages           Message[]
  aiRuns             AiRun[]
  aiToolCalls        AiToolCall[]
  portalEnquiries    PortalEnquiry[]
  portalContacts     PortalContactEvent[]
  listingReports     PortalListingReport[]
  feeRules           FeeRule[]
  propertyPhotos     PropertyPhoto[]
  viewings           Viewing[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]
  deals              Deal[]
  voiceCalls         VoiceCall[]
  subscription       Subscription?
  spendingCaps       SpendingCap[]
  dealSplits         DealCommissionSplit[]
  dealTasks          DealTask[]
  logo               AgencyLogo?
  voiceLines         VoiceLine[]

  @@map("agency")
}

model AgencySettings {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  branding               Json     @default("{}")
  aiSettings             Json     @default("{}") @map("ai_settings")
  listingFreshnessDays   Int      @default(14) @map("listing_freshness_days")
  /// When true, a listing can only go live with an unexpired advertising permit on file.
  requirePermitToPublish Boolean  @default(true) @map("require_permit_to_publish")
  /// Outbound AI voice calling stays off until compliance approvals are verified by a platform admin.
  outboundVoiceEnabled   Boolean  @default(false) @map("outbound_voice_enabled")
  retentionPolicy        Json     @default("{}") @map("retention_policy")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agency_settings")
}

model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency      Agency       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@map("team")
}

enum Role {
  owner
  admin
  manager
  agent
}

enum MembershipStatus {
  active
  suspended
  removed
}

model Membership {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  teamId          String?          @map("team_id") @db.Uuid
  role            Role
  status          MembershipStatus @default(active)
  /// Broker Registration Number; optional, entered by the agency.
  brn             String?
  /// Number shown to the public for calls about this agent's listings (E.164, e.g. +971501234567).
  publicPhoneE164 String?          @map("public_phone_e164")
  /// WhatsApp number for click-to-chat from the public portal (E.164).
  whatsappE164    String?          @map("whatsapp_e164")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  assignedProperties    Property[]
  ownedContacts         Contact[]
  assignedLeads         Lead[]
  viewings              Viewing[]
  deals                 Deal[]
  dealSplits            DealCommissionSplit[]
  assignedConversations Conversation[]
  portalEnquiries       PortalEnquiry[]
  portalContacts        PortalContactEvent[]
  photo                 MemberPhoto?

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String    @db.Citext
  role       Role
  teamId     String?   @map("team_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitation")
}

enum ActorType {
  user
  ai
  system
  platform
}

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
}

// ───────────────────────────── Inventory ─────────────────────────────

enum ListingType {
  sale
  rent
}

enum PropertyType {
  apartment
  villa
  townhouse
  penthouse
  office
  retail
  commercial
  land
  other
}

enum Completion {
  ready
  off_plan
}

enum PropertyStatus {
  draft
  active
  under_offer
  sold
  rented
  archived
}

enum Furnishing {
  unfurnished
  semi_furnished
  furnished
}

enum RentPeriod {
  yearly
  monthly
}

/// An off-plan or completed development that listings can belong to.
model Project {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  developer    String?
  emirate      String
  community    String?
  handoverDate DateTime? @map("handover_date") @db.Date
  /// Milestones, e.g. [{ "milestone": "On booking", "percent": 20 }]
  paymentPlan  Json?     @map("payment_plan")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency     Agency     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("project")
}

model Property {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  /// Agency-facing reference, unique within the agency.
  reference            String
  listingType          ListingType    @map("listing_type")
  propertyType         PropertyType   @map("property_type")
  completion           Completion     @default(ready)
  status               PropertyStatus @default(draft)
  projectId            String?        @map("project_id") @db.Uuid
  assignedMembershipId String?        @map("assigned_membership_id") @db.Uuid
  title                String?
  emirate              String
  community            String?
  subCommunity         String?        @map("sub_community")
  building             String?
  unitNo               String?        @map("unit_no")
  /// 0 = studio
  bedrooms             Int?
  bathrooms            Int?
  areaSqft             Decimal?       @map("area_sqft") @db.Decimal(10, 2)
  price                Decimal?       @db.Decimal(14, 2)
  /// Only for rentals.
  rentPeriod           RentPeriod?    @map("rent_period")
  furnishing           Furnishing?
  amenities            String[]       @default([])
  parking              Int?
  floor                Int?
  view                 String?
  developer            String?
  handoverDate         DateTime?      @map("handover_date") @db.Date
  paymentPlan          Json?          @map("payment_plan")
  serviceChargePerSqft Decimal?       @map("service_charge_per_sqft") @db.Decimal(8, 2)
  latitude             Decimal?       @db.Decimal(9, 6)
  longitude            Decimal?       @db.Decimal(9, 6)
  description          String?
  listingExpiresAt     DateTime?      @map("listing_expires_at") @db.Timestamptz(3)
  verifiedAt           DateTime?      @map("verified_at") @db.Timestamptz(3)
  verifiedBy           String?        @map("verified_by") @db.Uuid
  createdBy            String         @map("created_by") @db.Uuid
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency          Agency                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Composite keys: the database refuses a project or agent from another agency.
  project         Project?              @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: NoAction)
  assigned        Membership?           @relation(fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)
  permits         PropertyPermit[]
  portalEnquiries PortalEnquiry[]
  portalContacts  PortalContactEvent[]
  reports         PortalListingReport[]
  leads           Lead[]
  photos          PropertyPhoto[]
  viewings        Viewing[]
  deals           Deal[]

  @@unique([tenantId, reference])
  @@unique([id, tenantId])
  @@index([tenantId, status, listingType])
  @@index([tenantId, emirate, community])
  @@index([tenantId, assignedMembershipId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("property")
}

/// Advertising permit for a listing (e.g. a Dubai Trakheesi permit). Entered by the agency; the
/// platform does not verify it against the regulator.
model PropertyPermit {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  authority       String
  /// Optional when the agency uploads the permit document instead.
  permitNumber    String?  @map("permit_number")
  validUntil      DateTime @map("valid_until") @db.Date
  /// The link inside the regulator's QR code (DLD Trakheesi, ADREC). Must be https on a .gov.ae
  /// host; the portal draws the QR from it.
  verificationUrl String?  @map("verification_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property                @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  document PropertyPermitDocument?

  @@unique([tenantId, authority, permitNumber])
  @@unique([id, tenantId])
  @@index([propertyId])
  @@map("property_permit")
}

/// The scanned or PDF permit issued by the regulator. Private to the agency: the public portal has
/// no access to this table.
model PropertyPermitDocument {
  permitId    String   @id @map("permit_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// application/pdf, image/jpeg or image/png, detected from the file's bytes.
  contentType String   @map("content_type")
  fileName    String   @map("file_name")
  bytes       Bytes
  sha256      String
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permit PropertyPermit @relation(fields: [permitId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([permitId, tenantId])
  @@index([tenantId])
  @@map("property_permit_document")
}

// ───────────────────────────── Public portal ─────────────────────────────
// The public website (apps/portal) reads published listings through a read-only, row-level
// security view that is only switched on by withPublicPortal. Enquiries and contact clicks are
// written into the listing's agency, assigned to the listing's agent.

enum PortalEnquiryStatus {
  new
  contacted
  converted
  spam
  closed
}

enum PortalContactChannel {
  whatsapp
  call
}

/// An enquiry a visitor sent from the public portal about a listing.
model PortalEnquiry {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  propertyId       String              @map("property_id") @db.Uuid
  /// The agent the listing was assigned to when the enquiry arrived.
  membershipId     String              @map("membership_id") @db.Uuid
  fullName         String              @map("full_name")
  phoneE164        String              @map("phone_e164")
  email            String?             @db.Citext
  message          String
  status           PortalEnquiryStatus @default(new)
  /// Consent to be contacted about this enquiry (required) and to receive marketing (optional).
  consentContact   Boolean             @map("consent_contact")
  consentMarketing Boolean             @default(false) @map("consent_marketing")
  /// The exact wording the visitor agreed to, kept as evidence of consent.
  consentText      String              @map("consent_text")
  consentAt        DateTime            @map("consent_at") @db.Timestamptz(3)
  /// Keyed hash of the visitor's IP address; the raw IP is never stored.
  ipHash           String?             @map("ip_hash")
  userAgent        String?             @map("user_agent")
  /// Set once the CRM turns this enquiry into a lead.
  leadId           String?             @map("lead_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency   Agency     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property   @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  agent    Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, membershipId, createdAt(sort: Desc)])
  @@index([tenantId, propertyId])
  @@map("portal_enquiry")
}

/// A visitor clicked WhatsApp or Call on a public listing.
model PortalContactEvent {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  propertyId   String               @map("property_id") @db.Uuid
  membershipId String               @map("membership_id") @db.Uuid
  channel      PortalContactChannel
  ipHash       String?              @map("ip_hash")
  userAgent    String?              @map("user_agent")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property   @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  agent    Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, membershipId, createdAt(sort: Desc)])
  @@map("portal_contact_event")
}

/// A visitor's report that a public listing is wrong, unavailable or fraudulent. Filed under the
/// listing's agency; PropForce admins can read every report.
model PortalListingReport {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  /// not_available | wrong_price | wrong_details | wrong_photos | fraud | other
  reason     String
  details    String?
  email      String?
  status     String   @default("open")
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([propertyId])
  @@map("portal_listing_report")
}

/// An agent's profile photo, shown with their listings on the public portal. Small images only
/// (the CRM resizes to 256x256 before upload); served by the API with the hash in the URL.
model MemberPhoto {
  membershipId String   @id @map("membership_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// image/webp, image/jpeg or image/png, detected from the file's bytes.
  contentType  String   @map("content_type")
  bytes        Bytes
  /// SHA-256 of the bytes (hex); changes whenever the photo changes, so URLs can be cached forever.
  sha256       String
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([membershipId, tenantId])
  @@index([tenantId])
  @@map("member_photo")
}

/// A listing photo. The clean original stays private; the portal and the app only ever get the
/// display and thumbnail versions, which carry the agency's logo (or the PropForce mark) as a
/// faint watermark.
model PropertyPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  /// 0 is the cover photo.
  position   Int
  /// SHA-256 of the clean original (hex); used to refuse the same photo twice on one listing.
  sha256     String
  width      Int
  height     Int
  /// Upright JPEG with EXIF/GPS removed, at most 2560 px. Never served to the public.
  original   Bytes
  /// 1600 px watermarked WebP.
  display    Bytes
  /// 480 px watermarked WebP.
  thumb      Bytes
  /// SHA-256 of the logo the watermark was made from; null for the PropForce mark.
  markSha256 String?  @map("mark_sha256")
  /// Goes up whenever the watermarked versions are re-rendered, so their URLs can be cached forever.
  version    Int      @default(1)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency   Agency   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([propertyId, sha256])
  @@index([tenantId, propertyId, position])
  @@map("property_photo")
}

/// The agency's logo, used as the watermark on its listing photos. PNG, at most 800 px.
model AgencyLogo {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  bytes     Bytes
  sha256    String
  width     Int
  height    Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agency_logo")
}

/// Rate-limit hits for public endpoints. Holds only keyed hashes, no tenant data.
model PublicRateHit {
  id        BigInt   @id @default(autoincrement())
  bucket    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([bucket, createdAt])
  @@map("public_rate_hit")
}

// ───────────────────────── CRM ─────────────────────────

enum ContactSource {
  manual
  import
  whatsapp
  portal
  referral
  website
  walk_in
  phone
  other
}

enum ConsentChannel {
  whatsapp
  sms
  email
  phone_call
}

/// service = replies and updates the contact asked for; marketing = promotions and new listings.
enum ConsentPurpose {
  service
  marketing
}

enum ConsentStatus {
  granted
  withdrawn
}

enum LeadIntent {
  buy
  rent
  sell
  let
}

enum LeadStage {
  new
  contacted
  qualified
  viewing
  negotiating
  won
  lost
}

enum LeadActivityType {
  note
  stage_changed
  assigned
  created
}

model Contact {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  fullName          String        @map("full_name")
  /// E.164, e.g. +971501234567. Unique within the agency.
  phoneE164         String?       @map("phone_e164")
  email             String?       @db.Citext
  nationality       String?
  preferredLanguage String?       @map("preferred_language")
  source            ContactSource @default(manual)
  /// Agent responsible for the relationship.
  ownerMembershipId String?       @map("owner_membership_id") @db.Uuid
  tags              String[]      @default([])
  notes             String?
  /// Hard stop: never contact on any channel, whatever consent says.
  doNotContact      Boolean       @default(false) @map("do_not_contact")
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency             Agency              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              Membership?         @relation(fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)
  consents           ConsentRecord[]
  leads              Lead[]
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  deals              Deal[]
  voiceCalls         VoiceCall[]

  @@unique([tenantId, phoneE164])
  @@unique([id, tenantId])
  @@index([tenantId, email])
  @@index([tenantId, ownerMembershipId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("contact")
}

/// Append-only consent history. The latest row per (contact, channel, purpose) is the current state.
model ConsentRecord {
  id         String         @id @default(uuid(7)) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  contactId  String         @map("contact_id") @db.Uuid
  channel    ConsentChannel
  purpose    ConsentPurpose
  status     ConsentStatus
  /// How it was captured, e.g. "verbal on call", "web form", "WhatsApp reply STOP".
  method     String
  /// Optional evidence: form id, message id, call note.
  evidence   String?
  recordedBy String?        @map("recorded_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agency  Agency  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, contactId, channel, purpose, createdAt(sort: Desc)])
  @@map("consent_record")
}

model Lead {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  contactId            String         @map("contact_id") @db.Uuid
  intent               LeadIntent
  stage                LeadStage      @default(new)
  assignedMembershipId String?        @map("assigned_membership_id") @db.Uuid
  /// The listing the lead first asked about, if any.
  propertyId           String?        @map("property_id") @db.Uuid
  source               ContactSource  @default(manual)
  emirate              String?
  communities          String[]       @default([])
  propertyTypes        PropertyType[] @default([]) @map("property_types")
  bedroomsMin          Int?           @map("bedrooms_min")
  bedroomsMax          Int?           @map("bedrooms_max")
  budgetMin            Decimal?       @map("budget_min") @db.Decimal(14, 2)
  budgetMax            Decimal?       @map("budget_max") @db.Decimal(14, 2)
  nextFollowUpAt       DateTime?      @map("next_follow_up_at") @db.Timestamptz(3)
  lostReason           String?        @map("lost_reason")
  closedAt             DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdBy            String         @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency     Agency         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact        @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assigned   Membership?    @relation(fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)
  property   Property?      @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: NoAction)
  activities LeadActivity[]
  viewings   Viewing[]
  deals      Deal[]

  @@unique([id, tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedMembershipId, stage])
  @@index([tenantId, contactId])
  @@index([tenantId, nextFollowUpAt])
  @@map("lead")
}

model LeadActivity {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  leadId      String           @map("lead_id") @db.Uuid
  type        LeadActivityType
  body        String?
  fromValue   String?          @map("from_value")
  toValue     String?          @map("to_value")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@map("lead_activity")
}

// ───── WhatsApp (Phase 2) ─────

enum WhatsAppAccountStatus {
  active
  disconnected
}

enum ConversationMode {
  ai
  human
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  client
  ai
  agent
  system
}

enum MessageStatus {
  received
  sent
  delivered
  read
  failed
}

/// An agency's own WhatsApp Business number, connected through Meta Embedded Signup.
model WhatsAppAccount {
  id                 String                @id @default(uuid(7)) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  wabaId             String                @map("waba_id")
  /// Meta's id for the number. Globally unique: webhooks are routed to the agency by it.
  phoneNumberId      String                @unique @map("phone_number_id")
  displayPhoneNumber String                @map("display_phone_number")
  /// Business token, AES-256-GCM encrypted (associated data: account id).
  accessTokenEnc     Bytes                 @map("access_token_enc")
  /// When Meta stops accepting the token (null = never). Agencies reconnect before this.
  tokenExpiresAt     DateTime?             @map("token_expires_at") @db.Timestamptz(3)
  status             WhatsAppAccountStatus @default(active)
  connectedBy        String                @map("connected_by") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency        Agency         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  campaigns     Campaign[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("whatsapp_account")
}

/// One thread per agency number and contact.
model Conversation {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  whatsappAccountId    String           @map("whatsapp_account_id") @db.Uuid
  contactId            String           @map("contact_id") @db.Uuid
  mode                 ConversationMode @default(ai)
  assignedMembershipId String?          @map("assigned_membership_id") @db.Uuid
  /// Start of the 24-hour customer service window.
  lastInboundAt        DateTime?        @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt        DateTime         @default(now()) @map("last_message_at") @db.Timestamptz(3)
  unreadCount          Int              @default(0) @map("unread_count")
  /// AI conversation state (stage, collected requirement fields, language).
  state                Json             @default("{}")
  summary              String?
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency   Agency          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  WhatsAppAccount @relation(fields: [whatsappAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact  Contact         @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignee Membership?     @relation(fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)
  messages Message[]
  aiRuns   AiRun[]

  @@unique([tenantId, whatsappAccountId, contactId])
  @@unique([id, tenantId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedMembershipId])
  @@map("conversation")
}

model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  author         MessageAuthor
  authorUserId   String?          @map("author_user_id") @db.Uuid
  /// Meta message id; the idempotency key for webhooks.
  wamid          String?
  type           String
  body           String?
  mediaId        String?          @map("media_id")
  mediaMimeType  String?          @map("media_mime_type")
  status         MessageStatus
  errorCode      Int?             @map("error_code")
  statusAt       DateTime?        @map("status_at") @db.Timestamptz(3)
  /// Set when an AI turn takes this inbound message, so two webhook deliveries never answer twice.
  aiClaimedAt    DateTime?        @map("ai_claimed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  agency       Agency       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, wamid])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("message")
}

/// One AI turn in a conversation: model, prompt version, tokens and outcome (for audit and spend).
model AiRun {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  conversationId     String   @map("conversation_id") @db.Uuid
  provider           String
  model              String
  promptVersion      String   @map("prompt_version")
  inputTokens        Int      @map("input_tokens")
  outputTokens       Int      @map("output_tokens")
  latencyMs          Int      @map("latency_ms")
  /// reply | handover
  outcome            String
  handoverReason     String?  @map("handover_reason")
  injectionSuspected Boolean  @map("injection_suspected")
  groundingFailures  String[] @default([]) @map("grounding_failures")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency       Agency       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("ai_run")
}

/// Every tool call the AI attempted, allowed or refused. Append-only.
model AiToolCall {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  tool           String
  /// Validated arguments, or only the argument names when validation failed.
  args           Json
  /// ok | approval_required | refused | error
  outcome        String
  code           String?
  latencyMs      Int      @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("ai_tool_call")
}

// ───────────────────────────── Cost calculator ─────────────────────────────
/// One fee in the UAE cost calculator. Rows without a tenant are PropForce's templates (seeded as
/// unverified samples); an agency's row with the same emirate + code overrides the template for
/// that agency. Every output built from these rules is labelled an estimate.
model FeeRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  emirate       String
  code          String
  label         String
  /// Which calculators include it: ready_sale, off_plan_sale, mortgage, rental, commercial_rental.
  calculators   String[]
  /// buyer | seller | tenant | landlord
  payer         String
  /// price | loan | annual_rent: what ratePct applies to.
  basis         String
  ratePct       Decimal?  @map("rate_pct") @db.Decimal(7, 4)
  /// Fixed amount in AED, added to the percentage part.
  amount        Decimal?  @db.Decimal(12, 2)
  vat           Boolean   @default(false)
  refundable    Boolean   @default(false)
  source        String
  /// unverified_sample | verified
  status        String    @default("unverified_sample")
  verifiedBy    String?   @map("verified_by") @db.Uuid
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, emirate])
  @@map("fee_rule")
}

// ───── Viewings (Phase 2) ─────

enum ViewingStatus {
  requested
  confirmed
  completed
  cancelled
  no_show
}

enum ViewingSource {
  agent
  ai
  portal
}

/// A property viewing with a client, on an agent's calendar.
model Viewing {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  leadId            String        @map("lead_id") @db.Uuid
  propertyId        String        @map("property_id") @db.Uuid
  agentMembershipId String        @map("agent_membership_id") @db.Uuid
  startsAt          DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime      @map("ends_at") @db.Timestamptz(3)
  status            ViewingStatus @default(confirmed)
  source            ViewingSource @default(agent)
  notes             String?
  /// What happened (after completed / no-show) or why it was cancelled.
  outcome           String?
  /// Set once the external calendar (Google) has the event; null until connected.
  externalEventId   String?       @map("external_event_id")
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency   Agency     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead       @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  property Property   @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  agent    Membership @relation(fields: [agentMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@unique([id, tenantId])
  @@index([tenantId, agentMembershipId, startsAt])
  @@index([tenantId, startsAt])
  @@index([tenantId, leadId])
  @@map("viewing")
}

// ───── Lead Booster: WhatsApp template campaigns (Phase 3) ─────

enum CampaignStatus {
  draft
  pending_approval
  approved
  sending
  completed
  cancelled
}

enum CampaignRecipientStatus {
  queued
  skipped
  sent
  failed
  replied
}

/// A WhatsApp template message to a consented segment of contacts. Never sends without approval.
model Campaign {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  name              String
  whatsappAccountId String         @map("whatsapp_account_id") @db.Uuid
  /// Name of a template approved by Meta on the agency's WhatsApp Business account.
  templateName      String         @map("template_name")
  languageCode      String         @map("language_code")
  /// Body parameters in order ({{1}}, {{2}}…); may use {first_name}, {full_name}, {agency_name}.
  bodyParams        Json           @default("[]") @map("body_params")
  /// Segment filter (tags, lead stages, intents, emirate, communities, sources).
  audience          Json           @default("{}")
  status            CampaignStatus @default(draft)
  /// Most template messages this agency may send in any 24 hours (Meta messaging tier).
  dailyLimit        Int            @default(250) @map("daily_limit")
  createdBy         String         @map("created_by") @db.Uuid
  submittedAt       DateTime?      @map("submitted_at") @db.Timestamptz(3)
  approvedBy        String?        @map("approved_by") @db.Uuid
  approvedAt        DateTime?      @map("approved_at") @db.Timestamptz(3)
  startedAt         DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency     Agency              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount     @relation(fields: [whatsappAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("campaign")
}

model CampaignRecipient {
  id         String                  @id @default(uuid(7)) @db.Uuid
  tenantId   String                  @map("tenant_id") @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  contactId  String                  @map("contact_id") @db.Uuid
  status     CampaignRecipientStatus @default(queued)
  /// Why the contact is not messaged (no consent, do not contact, no phone…).
  skipReason String?                 @map("skip_reason")
  wamid      String?
  errorCode  Int?                    @map("error_code")
  sentAt     DateTime?               @map("sent_at") @db.Timestamptz(3)
  repliedAt  DateTime?               @map("replied_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, contactId, sentAt])
  @@index([tenantId, sentAt])
  @@map("campaign_recipient")
}

// ───── Deals and commissions (Phase 3) ─────

enum DealType {
  sale
  rental
}

enum CommissionStatus {
  pending
  invoiced
  received
}

/// A transaction in progress. Stages are validated per type in the API.
model Deal {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  reference            String
  type                 DealType
  stage                String
  leadId               String?          @map("lead_id") @db.Uuid
  /// Buyer or tenant.
  contactId            String           @map("contact_id") @db.Uuid
  propertyId           String?          @map("property_id") @db.Uuid
  agentMembershipId    String           @map("agent_membership_id") @db.Uuid
  /// Agreed price (sale) or yearly rent (rental), AED.
  price                Decimal          @db.Decimal(14, 2)
  /// Gross commission before VAT: a percentage of the price, or a fixed amount.
  commissionPercent    Decimal?         @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount     Decimal?         @map("commission_amount") @db.Decimal(14, 2)
  vatPercent           Decimal          @default(5) @map("vat_percent") @db.Decimal(5, 2)
  commissionStatus     CommissionStatus @default(pending) @map("commission_status")
  invoiceNumber        String?          @map("invoice_number")
  invoicedAt           DateTime?        @map("invoiced_at") @db.Timestamptz(3)
  commissionReceivedAt DateTime?        @map("commission_received_at") @db.Timestamptz(3)
  expectedCloseDate    DateTime?        @map("expected_close_date") @db.Date
  closedAt             DateTime?        @map("closed_at") @db.Timestamptz(3)
  lostReason           String?          @map("lost_reason")
  notes                String?
  createdBy            String           @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency   Agency                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?                 @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: NoAction)
  contact  Contact               @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: NoAction)
  property Property?             @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: NoAction)
  agent    Membership            @relation(fields: [agentMembershipId, tenantId], references: [id, tenantId], onDelete: NoAction)
  splits   DealCommissionSplit[]
  tasks    DealTask[]

  @@unique([tenantId, reference])
  @@unique([id, tenantId])
  @@index([tenantId, type, stage])
  @@index([tenantId, agentMembershipId])
  @@index([tenantId, closedAt])
  @@map("deal")
}

/// Who gets what share of the gross commission: a team member or an outside party (co-broker).
model DealCommissionSplit {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  dealId       String   @map("deal_id") @db.Uuid
  membershipId String?  @map("membership_id") @db.Uuid
  /// For outside parties (e.g. co-broker agency name).
  partyName    String?  @map("party_name")
  percent      Decimal  @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal        @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)
  member Membership? @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@index([tenantId, dealId])
  @@index([tenantId, membershipId])
  @@map("deal_commission_split")
}

/// Checklist item / milestone on a deal.
model DealTask {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  dealId    String    @map("deal_id") @db.Uuid
  title     String
  dueDate   DateTime? @map("due_date") @db.Date
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  doneBy    String?   @map("done_by") @db.Uuid
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, dealId, position])
  @@map("deal_task")
}

// ───── Billing (Phase 3) ─────

/// The plan catalogue (platform-wide, not tenant data). Prices are set by the platform admin.
model BillingPlan {
  code             String   @id
  name             String
  /// Monthly price in AED before VAT. Null = not priced yet / on request.
  priceMonthlyAed  Decimal? @map("price_monthly_aed") @db.Decimal(12, 2)
  /// Null = unlimited (or custom).
  seatLimit        Int?     @map("seat_limit")
  listingLimit     Int?     @map("listing_limit")
  aiRepliesMonthly Int?     @map("ai_replies_monthly")
  whatsappNumbers  Int?     @map("whatsapp_numbers")
  storageGb        Int?     @map("storage_gb")
  leadBooster      Boolean  @default(false) @map("lead_booster")
  /// none | inbound | inbound_outbound
  voice            String   @default("none")
  /// Shown to agencies and selectable.
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("billing_plan")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

/// One per agency. Without a payment provider, the platform admin sets it by hand.
model Subscription {
  tenantId               String             @id @map("tenant_id") @db.Uuid
  planCode               String             @map("plan_code")
  status                 SubscriptionStatus @default(trialing)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// stripe | checkout | telr | paytabs | manual. Null until a provider is wired.
  provider               String?
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   BillingPlan @relation(fields: [planCode], references: [code])

  @@index([status])
  @@map("subscription")
}

enum UsageMeter {
  ai_replies
  whatsapp_messages
}

enum CapAction {
  warn
  block
}

/// Monthly ceiling an owner sets on a usage meter.
model SpendingCap {
  tenantId     String     @map("tenant_id") @db.Uuid
  meter        UsageMeter
  monthlyLimit Int        @map("monthly_limit")
  action       CapAction  @default(warn)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, meter])
  @@map("spending_cap")
}

// ───────────────────────── Website content (platform-managed) ─────────────────────────

/// Platform-wide content and settings edited by platform admins: "portal" (public website text,
/// contact details, announcement bar, SEO) and "platform" (support details, defaults for new
/// agencies, notice shown inside every agency's app). Values are validated by the API.
model SiteSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_setting")
}

/// A banner or advert on the public website, managed by platform admins. Shown only while
/// active and inside its optional schedule.
model SiteBanner {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// home_hero | home_strip | search_top | listing_sidebar
  placement   String
  /// banner (PropForce's own promotion) | ad (paid advert, labelled "Sponsored")
  kind        String    @default("banner")
  title       String
  subtitle    String?
  ctaLabel    String?   @map("cta_label")
  /// https URL or a path on the portal ("/new-projects"). Clicks go through a counting redirect.
  linkUrl     String?   @map("link_url")
  advertiser  String?
  active      Boolean   @default(false)
  sortOrder   Int       @default(0) @map("sort_order")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  /// WebP, at most 2400 px wide, metadata removed. Null until an image is uploaded.
  image       Bytes?
  imageWidth  Int?      @map("image_width")
  imageHeight Int?      @map("image_height")
  /// SHA-256 of the image (hex); in image URLs so they can be cached for a long time.
  imageSha256 String?   @map("image_sha256")
  clicks      Int       @default(0)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([placement, active, sortOrder])
  @@map("site_banner")
}

// ───── Voice (Phase 4) ─────

enum VoiceTranscriptPolicy {
  /// Keep only the AI summary and outcome.
  summary_only
  /// Also keep the full transcript text.
  full_transcript
}

/// A phone number on the voice provider (e.g. a Vapi phone number) that answers for this agency.
model VoiceLine {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  /// vapi
  provider              String                @default("vapi")
  /// The provider's id for the number (globally unique): how webhooks find the agency.
  providerPhoneNumberId String                @unique @map("provider_phone_number_id")
  phoneE164             String?               @map("phone_e164")
  label                 String?
  transcriptPolicy      VoiceTranscriptPolicy @default(summary_only) @map("transcript_policy")
  active                Boolean               @default(true)
  createdBy             String                @map("created_by") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls  VoiceCall[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("voice_line")
}

enum VoiceDirection {
  inbound
  outbound
}

/// One finished call, from the provider's end-of-call report. Recordings are never stored here.
model VoiceCall {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  lineId         String         @map("line_id") @db.Uuid
  providerCallId String         @map("provider_call_id")
  direction      VoiceDirection @default(inbound)
  callerE164     String?        @map("caller_e164")
  contactId      String?        @map("contact_id") @db.Uuid
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?      @map("ended_at") @db.Timestamptz(3)
  durationSec    Int?           @map("duration_sec")
  /// Provider cost in USD.
  costUsd        Decimal?       @map("cost_usd") @db.Decimal(10, 4)
  endedReason    String?        @map("ended_reason")
  summary        String?
  /// Only kept when the line's policy is full_transcript.
  transcript     String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agency  Agency    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line    VoiceLine @relation(fields: [lineId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact Contact?  @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, providerCallId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, contactId])
  @@map("voice_call")
}
