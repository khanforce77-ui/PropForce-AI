{
  "name": "@propforce/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, row-level security and the tenant-aware database client.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:setup-local-roles": "node scripts/setup-local-roles.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@propforce/config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.16.0",
    "prisma": "7.10.1",
    "vitest": "^5.1.1"
  }
}
