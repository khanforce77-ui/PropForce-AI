# Copy to .env for local development. Names only for anything secret: never commit real values.

# --- API ---
NODE_ENV=development
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Comma-separated. Launch scope (Dubai only vs Dubai + Abu Dhabi) is still to be decided.
SUPPORTED_EMIRATES=Dubai,Abu Dhabi

APP_WEB_URL=http://localhost:3000

# --- Auth ---
# Ed25519 PEM keys, required in staging/production. Leave empty locally to use an ephemeral pair.
# Generate: node -e "require('jose').generateKeyPair('EdDSA',{extractable:true}).then(async k=>console.log(await require('jose').exportPKCS8(k.privateKey)+'\n'+await require('jose').exportSPKI(k.publicKey)))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# 32 random bytes, base64. Encrypts TOTP secrets (and later OAuth tokens). Required in staging/prod.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Email ---
# Mailpit from docker-compose (web UI at http://localhost:8025). Empty = emails are only logged.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=PropForce AI <no-reply@propforce.local>

# --- Scheduled jobs ---
# Vercel Cron sends this as a Bearer token to /v1/cron/* (daily payment reminders, 10:00 Dubai).
# 16+ random characters. Unset = the jobs refuse to run.
CRON_SECRET=

# --- Worker ---
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# --- Web (browser-visible) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Must match SUPPORTED_EMIRATES above.
NEXT_PUBLIC_SUPPORTED_EMIRATES=Dubai,Abu Dhabi

# --- Database ---
# Migrations run as the schema owner. The app connects as a separate non-owner role so that
# row-level security applies; create it locally with `pnpm db:setup`.
MIGRATION_DATABASE_URL=postgresql://propforce:propforce_dev_only@localhost:5432/propforce
DATABASE_URL=postgresql://propforce_app_user:propforce_app_dev_only@localhost:5432/propforce

# --- Used in later PRs (local docker-compose values) ---
# S3_ENDPOINT=http://localhost:9000

# --- Integrations (pending; leave empty until credentials exist) ---
# AI replies on WhatsApp: fake (scripted) locally; openai when OPENAI_API_KEY is set when deployed.
# AI_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_MONTHLY_TOKEN_CAP=2000000
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_ES_CONFIG_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Captcha (Cloudflare Turnstile) for portal enquiries and listing reports ---
# Both empty = captcha off (honeypot and rate limits still apply). Set both to turn it on.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
