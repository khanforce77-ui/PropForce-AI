    "@propforce/calendar": "workspace:*",
    "@propforce/contracts": "workspace:*",
    "@propforce/db": "workspace:*",
    "@propforce/media": "workspace:*",
    "@propforce/whatsapp": "workspace:*",
    "@vercel/functions": "^3.11.3",
    "cookie-parser": "^1.4.7",
